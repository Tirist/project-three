# Copy to .env in the repository root (do not commit .env).
# launchd/systemd/cron can also export these before invoking ops/run_prod_data.sh

# Repository root (optional; run script cd's to repo automatically)
# PROJECT_ROOT=/path/to/Project Three

PIPELINE_MODE=prod
PYTHONPATH=
PYTHONUNBUFFERED=1

# Parallel workers for fetch_data when using ops/run_prod_data.sh
PROD_DATA_PARALLEL=8

# Failure notifications (preferred over config/test_schedules.yaml webhook_url)
# PIPELINE_WEBHOOK_URL=https://hooks.slack.com/services/...
